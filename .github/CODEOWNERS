# 保護パスに対するレビュー要求の宛先。
#
# 【これは壁ではない】PRの作成者が唯一のコードオーナーの場合、GitHubは本人に
# レビューを要求しない（自己承認できないため）。require_code_owner_review は
# 実質的に無効化される。実測: PR #2 が承認なしで自動マージされた。
#
# 実際に自動マージを止めているのは .github/workflows/automerge.yml の判定。
# 保護パスを増減させるときは、そちらの grep パターンと CLAUDE.md の表も直す。
# 協力者が増えたらこのファイルがレビュー要求として機能し始める。

# ガードレール自体。ここを自動マージ可にすると、AIが自分の制約を緩める
# 変更を無人でマージできてしまう。
/.github/          @rikunishi45
/.claude/          @rikunishi45
/CLAUDE.md         @rikunishi45

# レビューの判定基準。AIがここを書き換えられると、別モデルのレビューを
# 自分に都合よく採点させられる。
/AGENTS.md         @rikunishi45

# 人間が手で実行するブートストラップ。AIが書き換えられると、
# 人間の手で任意の gh api が走る。
/setup-github.sh   @rikunishi45

# src/ に対する壁の定義。AIがここを書き換えられると、中身を exit 0 に
# して壁を無効化できる。テスト本体（tests/）は保護しない。
/run-tests.sh      @rikunishi45

# カバレッジ・ミューテーションスコアの閾値の定義。Strykerのthresholdsは
# CLIから上書きできず設定ファイルにしか書けないため、ここを保護しないと
# run-tests.sh を保護している意味がなくなる。
/vitest.config.ts    @rikunishi45
/stryker.config.mjs  @rikunishi45

# run-tests.sh が npx で直接呼ぶツール（Vitest/Stryker）のバージョンを決める。
# 非保護のままだと、しきい値ファイルを変えずにツールのバージョンを差し替えて
# 壁を弱められる（push前レビューでCodexに実際に指摘された）。
/package.json        @rikunishi45
/package-lock.json   @rikunishi45

# npx tsc --noEmit（run-tests.sh 内）の挙動を決める。strictを外す等で
# 型チェックの壁を弱められる（push前レビューでCodexに指摘された）。
/tsconfig.json       @rikunishi45
